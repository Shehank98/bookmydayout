rules_version = '2';

// Firebase Storage security rules for BookMyDayOut.
// Deploy with: firebase deploy --only storage
//
// Listing images live under: /listings/{ownerUid}/{listingId}/{fileName}
// where ownerUid is the vendor's FIREBASE UID (Storage rules can only match on
// request.auth.uid, not our internal vendor UUID). The backend maps the
// authenticated user's Firebase UID to their vendor row. Only the owning
// authenticated user may upload; uploads are images up to 5MB. Read is public.

service firebase.storage {
  match /b/{bucket}/o {

    // Public read for listing images (the site is a public directory).
    match /listings/{ownerUid}/{listingId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Vendor verification documents (NIC / business reg) — private to owner + admins.
    // Admin access is enforced by the backend; Storage keeps these owner-only.
    match /vendor-docs/{ownerUid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == ownerUid;
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
