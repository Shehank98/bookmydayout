# ------------------------------------------------------------------
# BookMyDayOut backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file (it is git-ignored).
# On Railway, set these in the service "Variables" tab instead.
# ------------------------------------------------------------------

# App
NODE_ENV=development
PORT=8080

# Comma-separated list of allowed frontend origins for CORS.
# Example: http://localhost:5173,https://bookmydayout.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------
# PostgreSQL (Railway-managed Postgres)
# Railway exposes this automatically as DATABASE_URL for the service.
# Locally, point it at your own Postgres instance.
# ------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/bookmydayout?schema=public

# ------------------------------------------------------------------
# Firebase Admin SDK (for verifying ID tokens on the backend)
# Get these from Firebase console > Project settings > Service accounts.
# Provide EITHER the three fields below, OR a single JSON blob in
# FIREBASE_SERVICE_ACCOUNT_JSON (the whole service-account JSON on one line).
# The private key must keep its \n line breaks (wrap the value in quotes).
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Storage bucket (e.g. your-project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------
# Listing image rules (enforced server-side at submit time)
# ------------------------------------------------------------------
LISTING_MIN_IMAGES=3
LISTING_MAX_IMAGES=10

# When true, editing a live listing sends it back to "pending" for re-review.
MODERATE_LISTING_EDITS=true
